generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  FREELANCER
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}
enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}
enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
}
enum BudgetType {
  FIXED
  HOURLY
}
enum JobStatus {
  DRAFT
  OPEN
  IN_REVIEW
  NEGOTIATING
  FILLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}
enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  NEGOTIATING
  SELECTED
  REJECTED
  WITHDRAWN
}
enum ProposalStatus {
  DRAFT
  SUBMITTED
  UPDATED
  WITHDRAWN
}
enum QuotationStatus {
  DRAFT
  SUBMITTED
  UPDATED
  ACCEPTED
  REJECTED
  WITHDRAWN
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
}
enum AgreementStatus {
  DRAFT
  PENDING_CLIENT_CONFIRMATION
  PENDING_FREELANCER_CONFIRMATION
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}
enum ProjectStatus {
  PENDING_PAYMENT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  DISPUTED
}
enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  RESUBMITTED
  ACCEPTED
  COMPLETED
  CANCELLED
}
enum DeliverableStatus {
  SUBMITTED
  IN_REVIEW
  REVISION_REQUESTED
  RESUBMITTED
  ACCEPTED
}
enum RevisionStatus {
  OPEN
  ACKNOWLEDGED
  RESUBMITTED
  RESOLVED
  CANCELLED
}
enum ChangeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
  CANCELLED
}
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}
enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}
enum NotificationType {
  APPLICATION
  INVITATION
  PROPOSAL
  QUOTATION
  SHORTLIST
  SELECTION
  AGREEMENT
  PAYMENT
  PROJECT
  MILESTONE
  DELIVERABLE
  REVISION
  REVIEW
  MESSAGE
  DISPUTE
  SYSTEM
}
enum FileVisibility {
  PUBLIC
  OWNER_ONLY
  PROJECT_PARTICIPANTS
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  role            Role
  fullName        String
  avatarUrl       String?
  bio             String?
  location        String?
  timezone        String?
  phone           String?
  status          UserStatus    @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  freelancerProfile FreelancerProfile?
  clientProfile     ClientProfile?
  jobs               Job[]                @relation("ClientJobs")
  applications       Application[]        @relation("FreelancerApplications")
  invitationsSent    Invitation[]         @relation("InvitationClient")
  invitationsReceived Invitation[]        @relation("InvitationFreelancer")
  savedJobs          SavedJob[]
  savedFreelancers   SavedFreelancer[]    @relation("SavedByClient")
  savedByClients     SavedFreelancer[]    @relation("SavedFreelancer")
  shortlists         Shortlist[]          @relation("ShortlistClient")
  shortlistedBy      Shortlist[]          @relation("ShortlistFreelancer")
  clientAgreements   Agreement[]          @relation("AgreementClient")
  freelancerAgreements Agreement[]        @relation("AgreementFreelancer")
  clientProjects     Project[]            @relation("ProjectClient")
  freelancerProjects Project[]            @relation("ProjectFreelancer")
  submittedDeliverables Deliverable[]     @relation("DeliverableSubmitter")
  requestedRevisions RevisionRequest[]    @relation("RevisionRequester")
  acknowledgedRevisions RevisionRequest[] @relation("RevisionFreelancer")
  changeRequests     ChangeRequest[]       @relation("ChangeRequestRequester")
  paymentsMade       Payment[]            @relation("PaymentPayer")
  paymentsReceived   Payment[]            @relation("PaymentPayee")
  reviewsWritten     Review[]              @relation("Reviewer")
  reviewsReceived    Review[]              @relation("Reviewee")
  talentCreditTransactions TalentCreditTransaction[]
  notifications      Notification[]
  conversationParticipants ConversationParticipant[]
  messages           Message[]
  disputesCreated    Dispute[]             @relation("DisputeReporter")
  reportsCreated     Report[]              @relation("ReportReporter")
  reportsAgainst     Report[]              @relation("ReportTargetUser")
  files              FileAsset[]
  activities         ProjectActivity[]
  adminAudits        AdminAudit[]          @relation("AuditAdmin")
  jobQuestions       JobQuestion[]
  jobQuestionAnswers JobQuestionAnswer[]
  applicationStatusChanges ApplicationStatusHistory[]
  negotiationsRequested Negotiation[]
  agreementConfirmations AgreementConfirmation[]
  jobStatusChanges JobStatusHistory[]

  @@index([role, status])
  @@index([createdAt])
}

model FreelancerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  headline          String?
  professionalTitle String?
  summary           String?
  experienceYears   Int      @default(0)
  education         Json?
  certifications    Json?
  languages         Json?
  hourlyRate        Decimal? @db.Decimal(12,2)
  availability      AvailabilityStatus @default(AVAILABLE)
  talentCredit      Int      @default(500)
  rating            Float    @default(0)
  reviewCount       Int      @default(0)
  completedProjects Int      @default(0)
  onTimeRate        Float    @default(100)
  profileCompletion Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  skills            FreelancerSkill[]
  categories        FreelancerCategory[]
  services          FreelancerService[]
  cvs               Cv[]
  portfolios        Portfolio[]

  @@index([availability, rating])
  @@index([talentCredit])
}

model ClientProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  companyName        String?
  companyLogoUrl     String?
  companyDescription String?
  industry           String?
  website            String?
  companySize        String?
  foundedYear        Int?
  contactInfo        String?
  verificationStatus String   @default("UNVERIFIED")
  rating             Float    @default(0)
  reviewCount        Int      @default(0)
  projectsPosted     Int      @default(0)
  projectsCompleted  Int      @default(0)
  totalSpending      Decimal  @default(0) @db.Decimal(14,2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields:[userId], references:[id], onDelete:Cascade)
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  jobs        Job[]
  freelancerCategories FreelancerCategory[]
  services    FreelancerService[]
}

model Skill {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  freelancerSkills FreelancerSkill[]
  jobSkills    JobSkill[]
}

model FreelancerSkill {
  freelancerId String
  skillId      String
  level        Int      @default(3)
  freelancer   FreelancerProfile @relation(fields:[freelancerId], references:[id], onDelete:Cascade)
  skill        Skill             @relation(fields:[skillId], references:[id], onDelete:Cascade)
  @@id([freelancerId, skillId])
  @@index([skillId])
}

model FreelancerCategory {
  freelancerId String
  categoryId   String
  freelancer   FreelancerProfile @relation(fields:[freelancerId], references:[id], onDelete:Cascade)
  category     Category           @relation(fields:[categoryId], references:[id], onDelete:Cascade)
  @@id([freelancerId, categoryId])
}

model FreelancerService {
  id           String   @id @default(cuid())
  freelancerId String
  categoryId   String?
  title        String
  description  String
  startingPrice Decimal? @db.Decimal(12,2)
  freelancer   FreelancerProfile @relation(fields:[freelancerId], references:[id], onDelete:Cascade)
  category     Category? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
}

model Cv {
  id             String   @id @default(cuid())
  freelancerId   String
  title          String
  professionalSummary String?
  workExperience Json?
  education      Json?
  skillsText     String?
  certifications Json?
  languages      Json?
  referencesText String?
  fileUrl        String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  freelancer     FreelancerProfile @relation(fields:[freelancerId], references:[id], onDelete:Cascade)
  applications   Application[]
}

model Portfolio {
  id           String   @id @default(cuid())
  freelancerId String
  title        String
  description  String
  role         String?
  technologies String[]
  mediaUrls    String[]
  externalUrl  String?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  freelancer   FreelancerProfile @relation(fields:[freelancerId], references:[id], onDelete:Cascade)
}

model Job {
  id            String   @id @default(cuid())
  clientId      String
  categoryId    String?
  title         String
  description   String
  experienceLevel ExperienceLevel @default(INTERMEDIATE)
  budgetType    BudgetType @default(FIXED)
  budgetMin     Decimal? @db.Decimal(12,2)
  budgetMax     Decimal? @db.Decimal(12,2)
  hourlyRateMin Decimal? @db.Decimal(10,2)
  hourlyRateMax Decimal? @db.Decimal(10,2)
  currency      String   @default("VND")
  deadline      DateTime?
  deliverables  String?
  revisionRequirements String?
  preferredFreelancerLevel String?
  location      String?
  isRemote      Boolean  @default(true)
  visibility    String   @default("PUBLIC")
  maxHires      Int      @default(1)
  status        JobStatus @default(DRAFT)
  publishedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        User     @relation("ClientJobs", fields:[clientId], references:[id], onDelete:Restrict)
  category      Category? @relation(fields:[categoryId], references:[id], onDelete:SetNull)
  skills        JobSkill[]
  screeningQuestions ScreeningQuestion[]
  applications  Application[]
  invitations   Invitation[]
  shortlists    Shortlist[]
  savedBy       SavedJob[]
  agreements    Agreement[]
  projects      Project[]
  questions     JobQuestion[]
  statusHistory JobStatusHistory[]
  reports       Report[]
  conversations Conversation[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([clientId])
}

model JobSkill {
  jobId   String
  skillId String
  required Boolean @default(true)
  job     Job   @relation(fields:[jobId], references:[id], onDelete:Cascade)
  skill   Skill @relation(fields:[skillId], references:[id], onDelete:Cascade)
  @@id([jobId, skillId])
  @@index([skillId])
}

model ScreeningQuestion {
  id       String @id @default(cuid())
  jobId    String
  question String
  required Boolean @default(false)
  job      Job @relation(fields:[jobId], references:[id], onDelete:Cascade)
}

model SavedJob {
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  job       Job  @relation(fields:[jobId], references:[id], onDelete:Cascade)
  @@id([userId, jobId])
}

model SavedFreelancer {
  clientId     String
  freelancerId String
  createdAt    DateTime @default(now())
  client       User @relation("SavedByClient", fields:[clientId], references:[id], onDelete:Cascade)
  freelancer   User @relation("SavedFreelancer", fields:[freelancerId], references:[id], onDelete:Cascade)
  @@id([clientId, freelancerId])
}

model Application {
  id           String @id @default(cuid())
  jobId        String
  freelancerId String
  cvId         String?
  status       ApplicationStatus @default(APPLIED)
  source       String @default("DIRECT")
  screeningAnswers Json?
  appliedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  job          Job @relation(fields:[jobId], references:[id], onDelete:Cascade)
  freelancer   User @relation("FreelancerApplications", fields:[freelancerId], references:[id], onDelete:Restrict)
  cv           Cv? @relation(fields:[cvId], references:[id], onDelete:SetNull)
  proposal     Proposal?
  quotation    Quotation?
  histories    ApplicationStatusHistory[]
  shortlists   Shortlist[]
  agreement    Agreement?
  invitation   Invitation?
  negotiations Negotiation[]

  @@unique([jobId, freelancerId])
  @@index([jobId, status])
  @@index([freelancerId, status])
}

model ApplicationStatusHistory {
  id            String @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  reason        String?
  changedById   String?
  createdAt     DateTime @default(now())
  application   Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  changedBy     User? @relation(fields:[changedById], references:[id], onDelete:SetNull)
  @@index([applicationId, createdAt])
}

model Proposal {
  id                  String @id @default(cuid())
  applicationId       String @unique
  coverLetter         String
  approach            String?
  estimatedTimeline   String?
  relevantExperience  String?
  proposedTerms       String?
  attachmentUrls      String[]
  status              ProposalStatus @default(SUBMITTED)
  version             Int @default(1)
  submittedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt
  application         Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  versions            ProposalVersion[]
}

model ProposalVersion {
  id          String @id @default(cuid())
  proposalId  String
  version     Int
  snapshot    Json
  createdAt   DateTime @default(now())
  proposal    Proposal @relation(fields:[proposalId], references:[id], onDelete:Cascade)
  @@unique([proposalId, version])
}

model Quotation {
  id             String @id @default(cuid())
  applicationId  String @unique
  amount         Decimal @db.Decimal(12,2)
  currency       String @default("VND")
  pricingType    BudgetType @default(FIXED)
  estimatedDays  Int
  scope          String
  deliverables   String
  revisionTerms  String?
  notes          String?
  status         QuotationStatus @default(SUBMITTED)
  version        Int @default(1)
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  application    Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  versions       QuotationVersion[]
}

model QuotationVersion {
  id          String @id @default(cuid())
  quotationId String
  version     Int
  snapshot    Json
  createdAt   DateTime @default(now())
  quotation   Quotation @relation(fields:[quotationId], references:[id], onDelete:Cascade)
  @@unique([quotationId, version])
}

model Invitation {
  id           String @id @default(cuid())
  jobId        String
  clientId     String
  freelancerId String
  applicationId String? @unique
  message      String?
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime?
  respondedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  job          Job @relation(fields:[jobId], references:[id], onDelete:Cascade)
  client       User @relation("InvitationClient", fields:[clientId], references:[id], onDelete:Restrict)
  freelancer   User @relation("InvitationFreelancer", fields:[freelancerId], references:[id], onDelete:Restrict)
  application  Application? @relation(fields:[applicationId], references:[id], onDelete:SetNull)
  @@unique([jobId, freelancerId])
  @@index([freelancerId, status])
}

model Shortlist {
  id            String @id @default(cuid())
  clientId      String
  freelancerId  String
  jobId         String?
  applicationId String?
  note          String?
  createdAt     DateTime @default(now())
  client        User @relation("ShortlistClient", fields:[clientId], references:[id], onDelete:Cascade)
  freelancer    User @relation("ShortlistFreelancer", fields:[freelancerId], references:[id], onDelete:Cascade)
  job           Job? @relation(fields:[jobId], references:[id], onDelete:Cascade)
  application   Application? @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  @@unique([clientId, freelancerId, jobId])
}

model Negotiation {
  id            String @id @default(cuid())
  applicationId String
  requestedById String
  message       String
  proposedAmount Decimal? @db.Decimal(12,2)
  proposedDays   Int?
  status        String @default("OPEN")
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  application   Application @relation(fields:[applicationId], references:[id], onDelete:Cascade)
  requestedBy   User @relation(fields:[requestedById], references:[id], onDelete:Restrict)
  @@index([applicationId, createdAt])
}

model Agreement {
  id             String @id @default(cuid())
  jobId          String
  clientId       String
  freelancerId   String
  applicationId  String @unique
  title          String
  scope          String
  deliverables   String
  amount         Decimal @db.Decimal(12,2)
  currency       String @default("VND")
  paymentTerms   String
  revisionTerms  String?
  cancellationTerms String?
  ownershipTerms String?
  confidentialityTerms String?
  startDate      DateTime?
  deadline       DateTime?
  status         AgreementStatus @default(PENDING_CLIENT_CONFIRMATION)
  clientConfirmedAt DateTime?
  freelancerConfirmedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  job            Job @relation(fields:[jobId], references:[id], onDelete:Restrict)
  client         User @relation("AgreementClient", fields:[clientId], references:[id], onDelete:Restrict)
  freelancer     User @relation("AgreementFreelancer", fields:[freelancerId], references:[id], onDelete:Restrict)
  application    Application @relation(fields:[applicationId], references:[id], onDelete:Restrict)
  project        Project?
  confirmations  AgreementConfirmation[]
  versions       AgreementVersion[]
  changeRequests ChangeRequest[]
}

model AgreementConfirmation {
  id          String @id @default(cuid())
  agreementId String
  userId      String
  role        Role
  confirmedAt DateTime @default(now())
  agreement   Agreement @relation(fields:[agreementId], references:[id], onDelete:Cascade)
  user        User @relation(fields:[userId], references:[id], onDelete:Restrict)
  @@unique([agreementId, userId])
}

model AgreementVersion {
  id          String @id @default(cuid())
  agreementId String
  version     Int
  snapshot    Json
  createdAt   DateTime @default(now())
  agreement   Agreement @relation(fields:[agreementId], references:[id], onDelete:Cascade)
  @@unique([agreementId, version])
}

model Project {
  id           String @id @default(cuid())
  agreementId  String @unique
  jobId        String
  clientId     String
  freelancerId String
  title        String
  status       ProjectStatus @default(PENDING_PAYMENT)
  progress     Int @default(0)
  startDate    DateTime?
  deadline     DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  agreement    Agreement @relation(fields:[agreementId], references:[id], onDelete:Restrict)
  job          Job @relation(fields:[jobId], references:[id], onDelete:Restrict)
  client       User @relation("ProjectClient", fields:[clientId], references:[id], onDelete:Restrict)
  freelancer   User @relation("ProjectFreelancer", fields:[freelancerId], references:[id], onDelete:Restrict)
  milestones   Milestone[]
  payments     Payment[]
  reviews      Review[]
  conversations Conversation[]
  disputes     Dispute[]
  changeRequests ChangeRequest[]
  files        FileAsset[]
  activities   ProjectActivity[]
  talentCreditTransactions TalentCreditTransaction[]
  reports      Report[]
  @@index([clientId, status])
  @@index([freelancerId, status])
}

model Milestone {
  id          String @id @default(cuid())
  projectId   String
  title       String
  description String
  amount      Decimal @db.Decimal(12,2)
  dueDate     DateTime?
  orderIndex  Int
  status      MilestoneStatus @default(PENDING)
  startedAt   DateTime?
  acceptedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  deliverables Deliverable[]
  revisions   RevisionRequest[]
  payments    Payment[]
  @@unique([projectId, orderIndex])
  @@index([projectId, status])
}

model Deliverable {
  id           String @id @default(cuid())
  milestoneId  String
  submittedById String
  title        String
  description  String
  fileUrls     String[]
  links        String[]
  status       DeliverableStatus @default(SUBMITTED)
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  milestone    Milestone @relation(fields:[milestoneId], references:[id], onDelete:Cascade)
  submittedBy  User @relation("DeliverableSubmitter", fields:[submittedById], references:[id], onDelete:Restrict)
  revisions    RevisionRequest[]
}

model RevisionRequest {
  id            String @id @default(cuid())
  milestoneId   String
  deliverableId String
  requestedById String
  freelancerId  String
  request       String
  reason        String?
  response      String?
  status        RevisionStatus @default(OPEN)
  createdAt     DateTime @default(now())
  acknowledgedAt DateTime?
  resolvedAt    DateTime?
  milestone     Milestone @relation(fields:[milestoneId], references:[id], onDelete:Cascade)
  deliverable   Deliverable @relation(fields:[deliverableId], references:[id], onDelete:Cascade)
  requestedBy   User @relation("RevisionRequester", fields:[requestedById], references:[id], onDelete:Restrict)
  freelancer    User @relation("RevisionFreelancer", fields:[freelancerId], references:[id], onDelete:Restrict)
}

model ChangeRequest {
  id           String @id @default(cuid())
  projectId    String
  agreementId  String
  requestedById String
  proposedScope String?
  proposedAmount Decimal? @db.Decimal(12,2)
  proposedDeadline DateTime?
  reason       String
  status       ChangeRequestStatus @default(PENDING)
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
  project      Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  agreement    Agreement @relation(fields:[agreementId], references:[id], onDelete:Cascade)
  requestedBy  User @relation("ChangeRequestRequester", fields:[requestedById], references:[id], onDelete:Restrict)
}

model Payment {
  id           String @id @default(cuid())
  projectId    String
  milestoneId  String?
  payerId      String
  payeeId      String
  amount       Decimal @db.Decimal(12,2)
  currency     String @default("VND")
  platformFee  Decimal @default(0) @db.Decimal(12,2)
  netAmount    Decimal @db.Decimal(12,2)
  status       PaymentStatus @default(PENDING)
  transactionCode String? @unique
  fundedAt     DateTime?
  releasedAt   DateTime?
  refundedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  milestone    Milestone? @relation(fields:[milestoneId], references:[id], onDelete:SetNull)
  payer        User @relation("PaymentPayer", fields:[payerId], references:[id], onDelete:Restrict)
  payee        User @relation("PaymentPayee", fields:[payeeId], references:[id], onDelete:Restrict)
  transactions PaymentTransaction[]
  @@index([projectId, status])
}

model PaymentTransaction {
  id         String @id @default(cuid())
  paymentId  String
  type       String
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  amount     Decimal @db.Decimal(12,2)
  reference  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  payment    Payment @relation(fields:[paymentId], references:[id], onDelete:Cascade)
}

model Review {
  id         String @id @default(cuid())
  projectId  String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  project    Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  reviewer   User @relation("Reviewer", fields:[reviewerId], references:[id], onDelete:Restrict)
  reviewee   User @relation("Reviewee", fields:[revieweeId], references:[id], onDelete:Restrict)
  reports    Report[]
  @@unique([projectId, reviewerId, revieweeId])
  @@index([revieweeId, createdAt])
}

model TalentCreditTransaction {
  id         String @id @default(cuid())
  userId     String
  projectId  String?
  changeAmount Int
  reason     String
  balanceAfter Int
  createdAt  DateTime @default(now())
  user       User @relation(fields:[userId], references:[id], onDelete:Cascade)
  project    Project? @relation(fields:[projectId], references:[id], onDelete:SetNull)
  @@index([userId, createdAt])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  deepLink  String?
  isRead    Boolean @default(false)
  createdAt DateTime @default(now())
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, isRead, createdAt])
}

model Conversation {
  id         String @id @default(cuid())
  projectId  String?
  jobId      String?
  title      String?
  lastMessageAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project? @relation(fields:[projectId], references:[id], onDelete:Cascade)
  job        Job? @relation(fields:[jobId], references:[id], onDelete:SetNull)
  participants ConversationParticipant[]
  messages    Message[]
  @@index([projectId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
  user           User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrls String[]
  createdAt      DateTime @default(now())
  editedAt       DateTime?
  conversation   Conversation @relation(fields:[conversationId], references:[id], onDelete:Cascade)
  sender         User @relation(fields:[senderId], references:[id], onDelete:Restrict)
  reports        Report[]
  @@index([conversationId, createdAt])
}

model Dispute {
  id          String @id @default(cuid())
  projectId   String
  reportedById String
  reason      String
  description String
  evidenceUrls String[]
  status      DisputeStatus @default(OPEN)
  resolution  String?
  adminNote   String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  project     Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  reportedBy  User @relation("DisputeReporter", fields:[reportedById], references:[id], onDelete:Restrict)
  @@index([status, createdAt])
}

model Report {
  id            String @id @default(cuid())
  reporterId    String
  targetUserId  String?
  jobId         String?
  projectId     String?
  reviewId      String?
  messageId     String?
  type          String
  reason        String
  description   String?
  status        ReportStatus @default(OPEN)
  resolution    String?
  createdAt     DateTime @default(now())
  resolvedAt    DateTime?
  reporter      User @relation("ReportReporter", fields:[reporterId], references:[id], onDelete:Restrict)
  targetUser    User? @relation("ReportTargetUser", fields:[targetUserId], references:[id], onDelete:SetNull)
  job           Job? @relation(fields:[jobId], references:[id], onDelete:SetNull)
  project       Project? @relation(fields:[projectId], references:[id], onDelete:SetNull)
  review        Review? @relation(fields:[reviewId], references:[id], onDelete:SetNull)
  message       Message? @relation(fields:[messageId], references:[id], onDelete:SetNull)
}

model FileAsset {
  id          String @id @default(cuid())
  ownerId     String
  projectId   String?
  category    String
  originalName String
  storedName  String
  mimeType    String
  sizeBytes   Int
  path        String
  visibility  FileVisibility @default(OWNER_ONLY)
  createdAt   DateTime @default(now())
  owner       User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  project     Project? @relation(fields:[projectId], references:[id], onDelete:Cascade)
  @@index([ownerId, category])
}

model ProjectActivity {
  id        String @id @default(cuid())
  projectId String
  actorId   String?
  type      String
  title     String
  detail    String?
  metadata  Json?
  createdAt DateTime @default(now())
  project   Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  actor     User? @relation(fields:[actorId], references:[id], onDelete:SetNull)
  @@index([projectId, createdAt])
}

model JobStatusHistory {
  id        String @id @default(cuid())
  jobId     String
  fromStatus JobStatus?
  toStatus   JobStatus
  changedById String?
  reason    String?
  createdAt DateTime @default(now())
  job       Job @relation(fields:[jobId], references:[id], onDelete:Cascade)
  changedBy User? @relation(fields:[changedById], references:[id], onDelete:SetNull)
  @@index([jobId, createdAt])
}

model AdminAudit {
  id        String @id @default(cuid())
  adminId   String
  action    String
  entityType String
  entityId  String
  detail    String?
  createdAt DateTime @default(now())
  admin     User @relation("AuditAdmin", fields:[adminId], references:[id], onDelete:Restrict)
  @@index([adminId, createdAt])
}

model JobQuestion {
  id        String @id @default(cuid())
  jobId     String
  userId    String
  question  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job @relation(fields:[jobId], references:[id], onDelete:Cascade)
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  answers   JobQuestionAnswer[]
}

model JobQuestionAnswer {
  id         String @id @default(cuid())
  questionId String
  userId     String
  answer     String
  createdAt  DateTime @default(now())
  question   JobQuestion @relation(fields:[questionId], references:[id], onDelete:Cascade)
  user       User @relation(fields:[userId], references:[id], onDelete:Cascade)
}
